# Copy this file to .env on the production host.
# Do not commit the real .env file.

# Core Paperless settings
PAPERLESS_URL=https://paperless.kai.coach
PAPERLESS_TIME_ZONE=America/New_York
PAPERLESS_OCR_LANGUAGE=eng

# Required secret; generate a strong value for production.
PAPERLESS_SECRET_KEY=REPLACE_ME

# Optional first admin bootstrap values; avoid keeping real credentials here.
PAPERLESS_ADMIN_USER=REPLACE_ME
PAPERLESS_ADMIN_PASSWORD=REPLACE_ME
PAPERLESS_ADMIN_MAIL=REPLACE_ME

# Database settings
PAPERLESS_DB_NAME=paperless
PAPERLESS_DB_USER=paperless
PAPERLESS_DB_PASSWORD=REPLACE_ME

# UID/GID used by the container, if your compose uses them.
USERMAP_UID=1000
USERMAP_GID=1000
